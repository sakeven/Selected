    "clip.ai.prompt.explain" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explain this content clearly. For code or an error, explain its purpose or cause and useful next steps. If only a URL is provided, do not claim to have read the page."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清楚地解释这份内容。对于代码或报错，说明用途或原因，并给出有用的下一步建议。如果只提供了链接，请勿声称已经阅读网页。"
          }
        }
      }
    },
    "clip.ai.prompt.extract" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extract the text from the attachment in reading order. Preserve headings, lists, and tables where possible. Mark anything illegible instead of guessing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按阅读顺序提取附件中的文字，尽量保留标题、列表和表格。无法辨认的部分请标注，不要猜测。"
          }
        }
      }
    },
    "clip.ai.prompt.label" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your instructions"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的要求"
          }
        }
      }
    },
    "clip.ai.prompt.placeholder" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What would you like AI to do with this content?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "希望 AI 如何处理这段内容或附件？"
          }
        }
      }
    },
    "clip.ai.prompt.polish" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polish this text for clarity and readability. Preserve its language, meaning, facts, and tone. Return only the revised text."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "润色这段文字，让表达更清晰、易读。保留原语言、含义、事实和语气，只返回润色后的内容。"
          }
        }
      }
    },
    "clip.ai.prompt.summarize" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summarize the content into concise key points. Preserve important facts and do not invent information."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将内容总结为简明要点，保留重要事实，不补充未经证实的信息。"
          }
        }
      }
    },
    "clip.ai.prompt.translateChinese" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translate the content into Simplified Chinese. Preserve meaning and formatting. Return only the translation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将内容翻译为简体中文，保留含义与格式，只返回译文。"
          }
        }
      }
    },
    "clip.ai.prompt.translateEnglish" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translate the content into English. Preserve meaning and formatting. Return only the translation."
          }
        },
        "zh-Hans" : {

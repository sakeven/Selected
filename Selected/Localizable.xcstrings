    },
    "clip.ai.prompt.polish" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polish this text for clarity and readability. Preserve its language, meaning, facts, and tone. Return only the revised text."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "润色这段文字，让表达更清晰、易读。保留原语言、含义、事实和语气，只返回润色后的内容。"
          }
        }
      }
    },
    "clip.ai.prompt.summarize" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summarize the content into concise key points. Preserve important facts and do not invent information."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将内容总结为简明要点，保留重要事实，不补充未经证实的信息。"
          }
        }
      }
    },

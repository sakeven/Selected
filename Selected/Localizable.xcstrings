      }
    },
    "%@: Clipboard input is available only for AI, command, and URL actions." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：只有 AI、命令和 URL 动作支持额外剪贴板输入。"
          }
        }
      }
    },
    "%@: Configure exactly one action type." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：必须且只能配置一种动作类型。"
          }
        }
      }
    },
    "%@: Invalid JSON Schema for tool %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：工具 %@ 的 JSON Schema 无效。"
          }
        }
      }
    },
    "%@: Invalid regular expression." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：正则表达式无效。"
          }
        }
      }
    },
    "%@: Invalid shortcut. Use a shortcut such as cmd shift c, with exactly one non-modifier key per combination." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：快捷键无效，请使用例如 cmd shift c，每个组合只能有一个普通按键。"
          }
        }
      }
    },
    "%@: Output handling is available only for command and AI actions." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：结果处理仅适用于命令和 AI 动作。"
          }
        }
      }
    },
    "%@: Secrets cannot have a default value. Enter the secret on the configuration page." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：密钥不能写入默认值，请在配置页输入。"
          }
        }
      }
    },
    "%@: Set either keycombo or keycombos, not both." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：keycombo 与 keycombos 只能设置一项。"
          }
        }
      }
    },
    "%@: Single-choice options require unique choices." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：单选必须有不重复的候选值。"
          }
        }
      }
    },
    "%@: The AI prompt cannot be empty." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：AI 提示词不能为空。"
          }
        }
      }
    },
    "%@: The command cannot be empty." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：命令不能为空。"
          }
        }
      }
    },
    "%@: The command for tool %@ cannot be empty." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：工具 %@ 的命令不能为空。"
          }
        }
      }
    },
    "%@: The default toggle value must be true or false." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：开关默认值须为 true 或 false。"
          }
        }
      }
    },
    "%@: The default value is not one of the choices." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：默认值不在候选值中。"
          }
        }
      }
    },
    "%@: The number of display labels must match the number of choices." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：显示名称数量必须与候选值一致。"
          }
        }
      }
    },
    "%@: The service name cannot be empty." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：服务名称不能为空。"
          }
        }
      }
    },
    "%@: The URL must include a scheme, such as https://." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
